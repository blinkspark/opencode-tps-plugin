{
  "name": "@blinkspark/opencode-tps-plugin",
  "version": "0.1.0",
  "description": "Shows tokens per second in the OpenCode Desktop session header.",
  "type": "module",
  "license": "MIT",
  "author": "BlinkSpark",
  "homepage": "https://github.com/blinkspark/opencode-tps-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blinkspark/opencode-tps-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/blinkspark/opencode-tps-plugin/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tps",
    "tokens",
    "desktop"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "assets"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.15"
  }
}
